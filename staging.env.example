# Variables del staging con Docker Compose (docs/despliegue/staging.md).
#
# Flujo:
#   1. cp staging.env.example .env.staging      # (.env.staging NO se commitea)
#   2. GENERAR secretos propios y reemplazar TODOS los valores «changeme-...»
#   3. docker compose -p trendy-staging --env-file .env.staging up -d --build
#
# Los «changeme-...» son placeholders públicos: el backend se NIEGA a arrancar
# si JWT_SECRET, SEED_ADMIN_PASSWORD o MYSQL_PASSWORD siguen empezando por
# «changeme» (o si JWT_SECRET tiene menos de 16 caracteres). MYSQL_ROOT_PASSWORD
# no lo valida el backend: cambialo igual.
#
# Para generar un secreto:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Reglas del formato (es un env-file de Compose):
#  - MYSQL_USER y MYSQL_PASSWORD NO pueden tener  @ : / ? # %  (van dentro de la
#    URL de la base). Un secreto hexadecimal es seguro.
#  - Un $ en cualquier valor se escribe $$ (si no, Compose lo toma como variable).

# --- Red -------------------------------------------------------------------
# Puerto del host donde se publica nginx (frontend + API). Si el 8080 está
# ocupado, usá otro.
STAGING_HTTP_PORT=8080
# Interfaz del host donde escucha nginx. 127.0.0.1 = solo esta máquina (por
# defecto). 0.0.0.0 lo expone a toda la red local, SIN HTTPS: hacelo solo a
# propósito y con secretos propios.
STAGING_BIND_ADDRESS=127.0.0.1

# --- MySQL (no se publica al host) -----------------------------------------
MYSQL_DATABASE=trendy
MYSQL_USER=trendy_user
# CAMBIAR
MYSQL_PASSWORD=changeme-password
# CAMBIAR
MYSQL_ROOT_PASSWORD=changeme-root-password

# --- Backend ---------------------------------------------------------------
NODE_ENV=production
# CAMBIAR: secreto con el que se firman los JWT (mínimo 16 caracteres).
JWT_SECRET=changeme-jwt-secret
# Vigencia del token (por defecto 1h).
JWT_EXPIRES_IN=1h

# --- Seed ------------------------------------------------------------------
# true = al arrancar el backend carga roles, categorías, productos y zonas de
# ejemplo (es idempotente: se puede dejar en true).
RUN_SEED=true
# Admin inicial opcional (el seed lo crea solo si están el correo y la
# contraseña; no existe otro camino para crear el primer admin). Si ese correo
# ya existe, no se modifica.
SEED_ADMIN_NOMBRE=Admin Staging
SEED_ADMIN_CORREO=admin@trendy.test
# CAMBIAR (mínimo 8 caracteres). El smoke test la lee de SMOKE_ADMIN_PASSWORD.
SEED_ADMIN_PASSWORD=changeme-admin-password

# --- Mercado Pago (credenciales de PRUEBA, nunca de producción) -------------
# Vacío = el módulo de pagos responde 503 al crear preferencias. Sin una URL
# pública Mercado Pago no puede notificar el webhook (ver la guía).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
# Vigencia en horas de la preferencia de pago (1 a 168; vacío = 24).
MERCADOPAGO_PREFERENCIA_HORAS=

# --- Frontend --------------------------------------------------------------
# URL de la API que se compila dentro del build. Relativa porque nginx hace
# proxy en el mismo origen; no hace falta cambiarla.
VITE_API_URL=/api/v1
