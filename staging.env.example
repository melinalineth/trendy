# Variables del staging con Docker Compose (docs/despliegue/staging.md).
#
# Uso:
#   cp staging.env.example .env.staging       # (.env.staging NO se commitea)
#   # editar los valores marcados con CAMBIAR
#   docker compose -p trendy-staging --env-file .env.staging up -d --build
#
# Los valores de abajo son PLACEHOLDERS: no sirven para producción. Generá
# secretos propios, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usá valores sin los caracteres @ : / ? # % (van dentro de la URL de la base).

# --- Red -------------------------------------------------------------------
# Puerto del host donde se publica nginx (frontend + API). El 80 estándar
# puede estar ocupado; con 8080 no pisa nada.
STAGING_HTTP_PORT=8080

# --- MySQL (no se publica al host) -----------------------------------------
MYSQL_DATABASE=trendy
MYSQL_USER=trendy_user
# CAMBIAR
MYSQL_PASSWORD=changeme-password
# CAMBIAR
MYSQL_ROOT_PASSWORD=changeme-root-password

# --- Backend ---------------------------------------------------------------
NODE_ENV=production
# CAMBIAR: secreto con el que se firman los JWT.
JWT_SECRET=changeme-jwt-secret
# Vigencia del token (por defecto 1h).
JWT_EXPIRES_IN=1h

# --- Seed ------------------------------------------------------------------
# true = al arrancar el backend carga roles, categorías, productos y zonas de
# ejemplo (es idempotente: se puede dejar en true).
RUN_SEED=true
# Admin inicial opcional (el seed lo crea solo si están el correo y la
# contraseña; no existe otro camino para crear el primer admin).
SEED_ADMIN_NOMBRE=Admin Staging
SEED_ADMIN_CORREO=admin@trendy.test
# CAMBIAR (mínimo 8 caracteres)
SEED_ADMIN_PASSWORD=changeme-admin-password

# --- Mercado Pago (credenciales de PRUEBA, nunca de producción) -------------
# Vacío = el módulo de pagos responde 503 al crear preferencias. Sin una URL
# pública Mercado Pago no puede notificar el webhook (ver la guía).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
# Vigencia en horas de la preferencia de pago (1 a 168; vacío = 24).
MERCADOPAGO_PREFERENCIA_HORAS=

# --- Frontend --------------------------------------------------------------
# URL de la API que se compila dentro del build. Relativa porque nginx hace
# proxy en el mismo origen; no hace falta cambiarla.
VITE_API_URL=/api/v1
