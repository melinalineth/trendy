# Copiar a backend/.env y completar con valores reales. backend/.env NO se commitea
# (ya esta cubierto por backend/.gitignore).

PORT=3000

# Conexion a MySQL usada por backend/src/config/database.js (mysql2 createPool).
# DB_HOST=mysql corresponde al nombre del servicio en docker-compose.yml.
# Para desarrollo LOCAL sin Docker, usar DB_HOST=localhost.
DB_HOST=mysql
DB_PORT=3306
DB_USER=user
DB_PASSWORD=changeme
DB_NAME=trendy

# Prisma 7 (src/config/prisma.js) y JWT (utils/jwt.js)
DATABASE_URL=mysql://user:changeme@localhost:3306/trendy
JWT_SECRET=
JWT_EXPIRES_IN=2h
# Sprint 4 / MOD-07: Mercado Pago (pago.service.js). Sin valores reales.
# MERCADOPAGO_ACCESS_TOKEN: credencial privada (crear preferencias y consultar pagos).
# MERCADOPAGO_WEBHOOK_SECRET: clave secreta del webhook; valida x-signature (RF-036). Sin ella el webhook responde 500.
# MERCADOPAGO_WEBHOOK_URL: URL pública de POST /api/v1/pagos/mercadopago/webhook (opcional).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=